{
  "info": {
    "name": "Web Security Fundamentals - E-commerce API",
    "description": "Task 3 security tests for the local/authorized training API. Set collection variables before running. Do not place real secrets in exported files.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "customerEmail", "value": "customer.task3@example.com" },
    { "key": "customerPassword", "value": "StrongPass123!" },
    { "key": "customerToken", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "adminId", "value": "" },
    { "key": "categoryId", "value": "1" },
    { "key": "otherUserId", "value": "999999" },
    { "key": "otherOrderId", "value": "999999" },
    { "key": "allowedOrigin", "value": "http://localhost:5173" },
    { "key": "blockedOrigin", "value": "https://evil.example" }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "01 Register valid customer - 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Task Three Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"0790000000\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "pm.test('No password hash is returned', () => { pm.expect(JSON.stringify(body)).not.to.include('password_hash'); });",
                "if (body.data && body.data.id) pm.collectionVariables.set('customerId', String(body.data.id));"
              ]
            }
          }]
        },
        {
          "name": "02 Duplicate email - 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Duplicate Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 409', () => pm.response.to.have.status(409));"] }
          }]
        },
        {
          "name": "03 Customer login - 200 and save token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('Token is returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                "if (body.token) pm.collectionVariables.set('customerToken', body.token);",
                "if (body.user && body.user.id) pm.collectionVariables.set('customerId', String(body.user.id));"
              ]
            }
          }]
        },
        {
          "name": "04 Wrong password - 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "05 Protected route without token - 401",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "06 Invalid token - 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid.training.token" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "Admin login - save token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Admin login status is 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('Admin role returned', () => pm.expect(body.user && body.user.role).to.eql('admin'));",
                "if (body.token) pm.collectionVariables.set('adminToken', body.token);",
                "if (body.user && body.user.id) pm.collectionVariables.set('adminId', String(body.user.id));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "02 Authorization and IDOR",
      "item": [
        {
          "name": "07 Customer tries to add product - 403",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"Forbidden Customer Product\",\n  \"description\": \"Customer must not create this\",\n  \"price\": 9.99,\n  \"stock_quantity\": 1,\n  \"sku\": \"CUSTOMER-FORBIDDEN-{{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"] }
          }]
        },
        {
          "name": "08 Admin adds valid product - 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"Security Test Product\",\n  \"description\": \"Created by admin during Task 3 testing\",\n  \"price\": 25.50,\n  \"stock_quantity\": 10,\n  \"sku\": \"SEC-{{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"] }
          }]
        },
        {
          "name": "11 User requests another user - 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/users/{{otherUserId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"] }
          }]
        },
        {
          "name": "11b User requests another order - 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/orders/{{otherOrderId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 404 by IDOR policy', () => pm.response.to.have.status(404));"] }
          }]
        },
        {
          "name": "Customer lists only own orders - 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/orders"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
          }]
        }
      ]
    },
    {
      "name": "03 Validation and Injection",
      "item": [
        {
          "name": "09 Negative product price - 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"Invalid Price Product\",\n  \"price\": -10,\n  \"stock_quantity\": 5,\n  \"sku\": \"NEG-{{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                "const body = pm.response.json();",
                "pm.test('Validation response is standardized', () => { pm.expect(body.success).to.eql(false); pm.expect(body.message).to.eql('Validation failed'); pm.expect(body.errors).to.be.an('array'); });"
              ]
            }
          }]
        },
        {
          "name": "10 Invalid email - 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Invalid Email User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"StrongPass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
          }]
        },
        {
          "name": "Invalid non-numeric product ID - 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/not-a-number"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 400 before database logic', () => pm.response.to.have.status(400));"] }
          }]
        },
        {
          "name": "Unexpected search-like ID input does not change SQL - 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/1%20OR%201=1"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Injection-like ID is rejected with 400', () => pm.response.to.have.status(400));"] }
          }]
        },
        {
          "name": "Invalid role on admin user creation - 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Invalid Role User\",\n  \"email\": \"invalid.role.{{$timestamp}}@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"role\": \"superadmin\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
          }]
        }
      ]
    },
    {
      "name": "04 Headers CORS Errors and XSS",
      "item": [
        {
          "name": "13 Unknown endpoint - 404",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/does-not-exist" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                "pm.test('No stack trace is exposed', () => pm.expect(pm.response.text().toLowerCase()).not.to.include('stack'));"
              ]
            }
          }]
        },
        {
          "name": "14 No password_hash in current user - 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.test('password_hash is absent', () => pm.expect(pm.response.text()).not.to.include('password_hash'));",
                "pm.test('password is absent', () => pm.expect(pm.response.text()).not.to.match(/\"password\"\s*:/));"
              ]
            }
          }]
        },
        {
          "name": "15 Helmet security headers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products" },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.test('X-Content-Type-Options is nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                "pm.test('Content-Security-Policy exists', () => pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string'));",
                "pm.test('Cross-Origin-Resource-Policy exists', () => pm.expect(pm.response.headers.get('Cross-Origin-Resource-Policy')).to.be.a('string'));"
              ]
            }
          }]
        },
        {
          "name": "Allowed CORS Origin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Origin", "value": "{{allowedOrigin}}" }],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Allowed origin succeeds', () => pm.response.to.have.status(200));",
                "pm.test('Access-Control-Allow-Origin matches', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('allowedOrigin')));"
              ]
            }
          }]
        },
        {
          "name": "Blocked CORS Origin - 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Origin", "value": "{{blockedOrigin}}" }],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Blocked origin returns 403', () => pm.response.to.have.status(403));"] }
          }]
        },
        {
          "name": "CORS Preflight OPTIONS",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "{{allowedOrigin}}" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "Content-Type, Authorization" }
            ],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Preflight succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));",
                "pm.test('Allowed methods header exists', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.be.a('string'));"
              ]
            }
          }]
        },
        {
          "name": "XSS-like product description is treated as JSON data",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"XSS Text Test\",\n  \"description\": \"<script>alert('xss')</script>\",\n  \"price\": 10,\n  \"stock_quantity\": 1,\n  \"sku\": \"XSS-{{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('API returns JSON, not rendered HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                "pm.test('Status is 201 when other fields are valid', () => pm.response.to.have.status(201));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "05 Rate Limiting - run this folder after restarting/resetting the local server",
      "item": [
        {
          "name": "12.1 Failed login attempt 1",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 1 is rejected as login failure', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "12.2 Failed login attempt 2",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 2 is rejected as login failure', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "12.3 Failed login attempt 3",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 3 is rejected as login failure', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "12.4 Failed login attempt 4",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 4 is rejected as login failure', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "12.5 Failed login attempt 5",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 5 is rejected as login failure', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "12.6 Limit exceeded - 429",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Sixth failed attempt is rate limited', () => pm.response.to.have.status(429));"] }
          }]
        }
      ]
    }
  ]
}
