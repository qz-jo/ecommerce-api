{
  "info": {
    "name": "Web Security Fundamentals - E-commerce API",
    "description": "Task 3 security tests. Run only against the local project or an explicitly authorized training environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "customerEmail", "value": "customer.task3@example.com" },
    { "key": "customerPassword", "value": "StrongPass123!" },
    { "key": "customerToken", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoryId", "value": "1" },
    { "key": "otherUserId", "value": "999999" },
    { "key": "otherOrderId", "value": "999999" },
    { "key": "allowedOrigin", "value": "http://localhost:5173" },
    { "key": "blockedOrigin", "value": "https://evil.example" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "01 Register valid user - 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Task Three Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"0790000000\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
            "var data = pm.response.json();",
            "pm.test('No password hash', function () { pm.expect(pm.response.text()).to.not.include('password_hash'); });",
            "if (data.data && data.data.id) { pm.collectionVariables.set('customerId', String(data.data.id)); }"
          ] } }]
        },
        {
          "name": "02 Duplicate email - 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Duplicate Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });"] } }]
        },
        {
          "name": "03 Customer login - 200",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
            "var data = pm.response.json();",
            "pm.test('Token returned', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
            "if (data.token) { pm.collectionVariables.set('customerToken', data.token); }",
            "if (data.user && data.user.id) { pm.collectionVariables.set('customerId', String(data.user.id)); }"
          ] } }]
        },
        {
          "name": "04 Wrong password - 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "05 Protected route without token - 401",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "06 Invalid token - 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid.training.token" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "Admin login - save token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
            "var data = pm.response.json();",
            "pm.test('Admin role', function () { pm.expect(data.user.role).to.eql('admin'); });",
            "if (data.token) { pm.collectionVariables.set('adminToken', data.token); }"
          ] } }]
        }
      ]
    },
    {
      "name": "Authorization and IDOR",
      "item": [
        {
          "name": "07 Customer adds product - 403",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"Customer Forbidden Product\",\n  \"price\": 10,\n  \"stock_quantity\": 1,\n  \"sku\": \"CUST-{{$timestamp}}\"\n}" },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "08 Admin adds product - 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"Security Test Product\",\n  \"description\": \"Created by admin\",\n  \"price\": 25.5,\n  \"stock_quantity\": 10,\n  \"sku\": \"SEC-{{$timestamp}}\"\n}" },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', function () { pm.response.to.have.status(201); });"] } }]
        },
        {
          "name": "11 User accesses another user - 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/users/{{otherUserId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "11b User accesses another order - 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/orders/{{otherOrderId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 by IDOR policy', function () { pm.response.to.have.status(404); });"] } }]
        }
      ]
    },
    {
      "name": "Validation and SQL Injection",
      "item": [
        {
          "name": "09 Negative product price - 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"Invalid Price Product\",\n  \"price\": -10,\n  \"stock_quantity\": 1,\n  \"sku\": \"NEG-{{$timestamp}}\"\n}" },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
            "pm.test('Validation failed response', function () { pm.expect(pm.response.json().message).to.eql('Validation failed'); });"
          ] } }]
        },
        {
          "name": "10 Invalid email - 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Invalid Email User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"StrongPass123!\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Non numeric ID - 400",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/not-a-number" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Injection-like ID - 400",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/1%20OR%201=1" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "Invalid admin-created role - 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Invalid Role\",\n  \"email\": \"invalid.role.{{$timestamp}}@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"role\": \"superadmin\"\n}" },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"] } }]
        }
      ]
    },
    {
      "name": "Headers CORS Errors and XSS",
      "item": [
        {
          "name": "13 Unknown endpoint - 404",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/not-found-task3" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', function () { pm.response.to.have.status(404); });",
            "pm.test('No stack text', function () { pm.expect(pm.response.text().toLowerCase()).to.not.include('stack'); });"
          ] } }]
        },
        {
          "name": "14 No password_hash - 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
            "pm.test('No password_hash field', function () { pm.expect(pm.response.text()).to.not.include('password_hash'); });"
          ] } }]
        },
        {
          "name": "15 Helmet headers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('X-Content-Type-Options', function () { pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'); });",
            "pm.test('Content-Security-Policy present', function () { pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string'); });",
            "pm.test('Cross-Origin-Resource-Policy present', function () { pm.expect(pm.response.headers.get('Cross-Origin-Resource-Policy')).to.be.a('string'); });"
          ] } }]
        },
        {
          "name": "Allowed CORS origin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Origin", "value": "{{allowedOrigin}}" }],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Blocked CORS origin - 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Origin", "value": "{{blockedOrigin}}" }],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "CORS preflight OPTIONS",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "{{allowedOrigin}}" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "Content-Type, Authorization" }
            ],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "XSS-like text remains JSON data",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{categoryId}},\n  \"name\": \"XSS Text Test\",\n  \"description\": \"<script>alert('xss')</script>\",\n  \"price\": 10,\n  \"stock_quantity\": 1,\n  \"sku\": \"XSS-{{$timestamp}}\"\n}" },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
            "pm.test('JSON response', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "12 Rate Limiting - run this folder alone after restarting the server",
      "item": [
        {
          "name": "Failed login 1",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Failed login 2",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Failed login 3",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Failed login 4",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Failed login 5",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Failed login 6 - expect 429",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('429 Too Many Requests', function () { pm.response.to.have.status(429); });"] } }]
        }
      ]
    }
  ]
}
